# Server
PORT=3001
NODE_ENV=development

# Database (Supabase PostgreSQL or any other PostgreSQL instance)
DATABASE_URL=postgresql://username:password@hostname:port/database
DATABASE_SSL=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d
ENABLE_EMAIL_VERIFICATION=true

# Email Configuration (Brevo HTTP API)
MAIL_API_KEY=your_brevo_api_key_here
MAIL_FROM=no-reply@yourdomain.com

# AI API Configuration (GROQ / Vercel AI SDK)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_RATE_LIMIT_REQUESTS=10

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Frontend Configuration
USER_BASE_URL=http://localhost:5173
